# ShellCheck configuration
# https://www.shellcheck.net/

# Can't follow non-constant source (we source from variables)
disable=SC1090

# Not following sourced file (external sources not checked here)
disable=SC1091

# Double quote to prevent globbing — intentionally unquoted in many places
disable=SC2086

# Allow scripts to find sourced files relative to the script location
source-path=SCRIPTDIR
source-path=SCRIPTDIR/../lib
