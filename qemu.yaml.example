# Alpine Diskless k3s Cluster Configuration - QEMU Testing Environment
# Copy this file to qemu.yaml and modify values to match your environment.
# qemu.yaml is gitignored to keep your real values out of the repo.
# This config mirrors k3s.yaml but with QEMU-appropriate values.

cluster:
  name: "alpine-k3s-test"
  k3s_version: "v1.35.0+k3s1"
  token: "" # Leave empty to auto-generate, or provide a throwaway test token

network:
  domain: "local"
  subnet: "10.99.0.0/24"
  gateway: "10.99.0.2"
  # Note: Using Cloudflare DNS for better reliability
  dns_servers:
    - "1.1.1.1"
    - "1.0.0.1"

  # MetalLB LoadBalancer IP range
  loadbalancer_pool:
    start: "10.99.0.70"
    end: "10.99.0.80"

nodes:
  - name: "qemu-test-1"
    ip: "10.99.0.15"
    role: "master"
    taints:
      - "CriticalAddonsOnly=true:NoExecute"

  - name: "qemu-test-2"
    ip: "10.99.0.16"
    role: "worker"

k3s:
  # Services to disable (k3s defaults: servicelb, traefik)
  #disable_services:
  #  - "servicelb"
  #  - "traefik"

  # External datastore for high availability (optional)
  # When enabled, all masters share the same backend database
  #datastore:
  #  type: "postgres"  # postgres, mysql
  #  host: "10.0.2.3"
  #  port: 5432
  #  database: "k3s"
  #  user: "k3s"
  #  password: "CHANGE_ME"
  #  # SSL mode: disable, require, verify-ca, verify-full
  #  sslmode: "disable"

  # Load balancer VIP for worker nodes (recommended for true HA)
  # Workers connect to this VIP which distributes across all masters
  #loadbalancer_vip: "10.0.2.100"

  # Cluster networking
  cluster_cidr: "10.42.0.0/16"
  service_cidr: "10.43.0.0/16"
  flannel_backend: "vxlan"

#services:
#  metallb:
#    enabled: true
#    version: "v0.13.12"
#
#  nginx_ingress:
#    enabled: true
#    version: "v1.8.4"
#    replicas: 2

alpine:
  version: "3.22.1"
  architecture: "x86_64"
  timezone: "UTC"

  # Additional packages to install
  packages:
    - "curl"
    - "ca-certificates"
    - "iptables"
    - "ip6tables"
    - "util-linux"
    - "coreutils"
    - "findutils"
    - "netcat-openbsd"
    - "cgroup-tools"
    - "parted"
    - "e2fsprogs"
    - "chrony"  # NTP time synchronization (required for SSL/TLS)
    # NFS client support (installed via apk for QEMU testing)
    - "nfs-utils"
    - "rpcbind"
    - "keyutils"
    - "libtirpc"
    - "krb5-libs"

storage:
  # Partition sizes (used by setup-bootable-device.sh for SD card preparation)
  boot_partition_size: "512MiB"

  # Persistent paths for bind mounts (handled by storage-init service)
  persistent_paths:
    - "/etc/k3s"
    - "/var/lib/k3s"

ssh:
  port: 22
  permit_root_login: true
  password_authentication: true

  # SSH public keys (add your keys here)
  authorized_keys:
    - "ssh-ed25519 AAAA...REPLACE_WITH_YOUR_PUBLIC_KEY your-name@example.com"

# Overlay packages - packages to include in apkovl for early boot
# Architecture-specific packages will be downloaded automatically
overlay_packages:
  - name: "openssh"
  - name: "e2fsprogs"
  - name: "e2fsprogs-libs"  # Shared libraries for mkfs.ext4
  - name: "libcom_err"  # Error description library
  - name: "libblkid"  # Block device ID library
  - name: "libuuid"  # UUID library
  - name: "libeconf"  # Config file library (needed by libblkid)
  - name: "libarchive"  # Archive library (needed by mke2fs)
  - name: "musl"  # C library and dynamic loader (ld-musl-x86_64.so.1)
  - name: "util-linux"  # Provides blkid, uuidgen binaries

# Services to auto-start at every boot
# Each package will be installed via 'apk add' and its service started automatically
# Service dependencies (like rpcbind for nfs) are handled by OpenRC
auto_start_services:
  - "nfs-utils"   # Installs package, starts 'nfs' service (rpcbind starts automatically)
