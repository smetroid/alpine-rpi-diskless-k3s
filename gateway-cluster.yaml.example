# Alpine Diskless k3s Gateway Cluster Configuration
# HA Home Gateway with OpenWrt on a dedicated 2-node k3s cluster
#
# This cluster IS the gateway — it owns the VIP and provides NAT/DHCP/DNS
# to the LAN. No upstream gateway is needed (no network.gateway).
#
# Hardware required:
#   2x Raspberry Pi 4/5 with 2x USB 3.0 Gigabit NIC (RTL8153 chipset)
#   1x LAN switch, ISP modem/router connected to WAN NICs

cluster:
  name: "ha-gateway"
  k3s_version: "v1.35.0+k3s1"
  token: ""

network:
  domain: "home.lab"
  lan_subnet: "192.168.1.0/24"
  vip: "192.168.1.1"                # Virtual IP — all devices point here
  
  dns_upstream:
    - "1.1.1.1"
    - "8.8.8.8"

nodes:
  - name: "gw-1"
    role: "master"
    interfaces:
      lan:
        device: "eth0"
        ip: "192.168.1.2/24"
      wan:
        device: "eth1"
        proto: "dhcp"               # or static, per ISP
    vrrp:
      state: "MASTER"
      priority: 200

  - name: "gw-2"
    role: "worker"
    interfaces:
      lan:
        device: "eth0"
        ip: "192.168.1.3/24"
      wan:
        device: "eth1"
        proto: "dhcp"
    vrrp:
      state: "BACKUP"
      priority: 100

k3s:
  disable_services:
    - "servicelb"
    - "traefik"
  cluster_cidr: "10.42.0.0/16"
  service_cidr: "10.43.0.0/16"
  flannel_backend: "vxlan"

services:
  metallb:
    enabled: false                  # Not needed — VIP handled by VRRP
  nginx_ingress:
    enabled: false                  # No ingress needed for gateway
  openwrt:
    enabled: true
    image: "albrechtloh/openwrt-docker:openwrt-25.12.5-2bca120"

alpine:
  version: "3.22.1"
  architecture: "aarch64"
  timezone: "America/Denver"
  packages:
    - "curl"
    - "ca-certificates"
    - "iptables"
    - "ip6tables"
    - "util-linux"
    - "coreutils"
    - "findutils"
    - "netcat-openbsd"
    - "cgroup-tools"
    - "parted"
    - "e2fsprogs"
    - "chrony"
    - "ethtool"                     # Required for USB NIC TX offload fix

storage:
  boot_partition_size: "512MiB"
  persistent_paths:
    - "/etc/k3s"
    - "/var/lib/k3s"
    - "/etc/openwrt"                # OpenWrt config persistence

ssh:
  port: 22
  permit_root_login: true
  password_authentication: true
  authorized_keys:
    # - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@host"

overlay_packages:
  - name: "openssh"
  - name: "chrony"
  - name: "chrony-openrc"
  - name: "e2fsprogs"
  - name: "e2fsprogs-libs"
  - name: "libcom_err"
  - name: "libblkid"
  - name: "libuuid"
  - name: "libeconf"
  - name: "libarchive"
  - name: "musl"
  - name: "util-linux"
  - name: "ethtool"

auto_start_services:
  - "rpcbind"
  - "chrony"
  - "keepalived"
