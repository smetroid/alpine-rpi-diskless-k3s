# Alpine diskless k3s .gitignore

# Prevent accidental upload of YAML config files (except the template)
*.yaml
!cluster-config.yaml

# Prevent accidental upload of Alpine images and build artifacts
*.tar.gz
*.iso
*.img

# Build outputs and generated files
builds/
builds-qemu/
k3s-token.txt
.worktrees/

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Log files
*.log

# SSH keys (if accidentally placed in project)
*.pem
*.key
id_rsa*
id_ed25519*

*.qcow2

# QEMU cluster runtime artifacts
test/qemu-cluster/
test/vm-*.log
test/*.pid