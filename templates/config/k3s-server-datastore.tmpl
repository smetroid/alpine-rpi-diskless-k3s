write-kubeconfig-mode: "0644"
bind-address: {{ .Env.NODE_IP }}
advertise-address: {{ .Env.NODE_IP }}
node-ip: {{ .Env.NODE_IP }}
cluster-cidr: "{{ .Env.CLUSTER_CIDR }}"
service-cidr: "{{ .Env.SERVICE_CIDR }}"
flannel-backend: "{{ .Env.FLANNEL_BACKEND }}"
datastore-endpoint: "{{ .Env.DATASTORE_ENDPOINT }}"
# Steer workloads to the agents: this node runs the control plane.
# Soft, so it still schedules if the agents are full.
node-taint:
  - "node-role.kubernetes.io/control-plane:PreferNoSchedule"
